{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "messenger",
  "version": "0.1.0",
  "identifier": "com.itshuaan.messenger",
  "build": {},
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Messenger",
        "url": "https://www.messenger.com",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}