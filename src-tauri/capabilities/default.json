{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "call-*"],
  "remote": {
    "urls": [
      "https://*.messenger.com/*",
      "https://messenger.com/*",
      "https://*.facebook.com/*"
    ]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "notification:default",
    "updater:default",
    "allow-notify-message",
    "allow-close-call-window",
    "allow-update-unread-badge",
    "allow-get-settings",
    "allow-set-notifications-enabled",
    "allow-set-badge-enabled",
    "allow-set-hide-message-content",
    "allow-set-badge-color",
    "allow-set-run-at-startup",
    "allow-set-minimize-to-tray",
    "allow-set-start-minimized-to-tray",
    "allow-check-for-updates",
    "allow-download-update",
    "allow-install-and-restart",
    "allow-get-update-status",
    "allow-cancel-download",
    "allow-get-active-downloads",
    "allow-open-downloaded-file",
    "allow-show-in-folder",
    "allow-get-default-download-dir",
    "allow-choose-download-dir",
    "allow-set-download-dir",
    "allow-set-ask-download-location",
    "allow-open-download-dir"
  ]
}
